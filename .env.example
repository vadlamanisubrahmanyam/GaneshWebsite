# Copy this file to .env.local for local dev, and add the same
# names/values in Vercel: Project -> Settings -> Environment Variables.
# Never commit the real .env or .env.local file to GitHub.

# Supabase Postgres connection string
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:PASSWORD@YOUR-PROJECT.supabase.co:5432/postgres"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Your email address (the same one you'll sign in with via Google).
# On sign-in, this account is automatically promoted to ADMIN — no manual
# role-setting step needed. Everyone else stays at the default USER role.
OWNER_EMAIL="you@example.com"

# Google OAuth (from console.cloud.google.com -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth (add when ready — see src/lib/auth.ts)
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# Microsoft OAuth (add when ready — see src/lib/auth.ts)
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
